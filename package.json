{
  "name": "relationship-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:local": "expo start --web --localhost",
    "web:serve": "npx serve dist -l 8080",
    "web:test": "playwright test",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "lint": "npx expo lint",
    "eas:preview": "eas build --platform all --profile preview",
    "eas:production": "eas build --platform all --profile production",
    "eas:ios:testflight": "eas build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.9",
    "expo-constants": "~19.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~14.0.9",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~8.0.8",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "~19.2.3",
    "eslint": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
