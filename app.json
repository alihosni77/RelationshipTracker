{
  "expo": {
    "name": "Hamqadam",
    "slug": "relationship-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "relationshiptracker",
    "userInterfaceStyle": "dark",
    "runtimeVersion": { "policy": "appVersion" },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-location"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alihosni.relationshiptracker",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "موقعیت مکانی فقط با رضایت صریح شما با پارتنر به اشتراک گذاشته می‌شود.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "موقعیت پس‌زمینه فقط در یک جلسه اشتراک‌گذاری که خودتان فعال کرده‌اید استفاده می‌شود.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alihosni.relationshiptracker",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
